  "illumination": {
    "levels": [0, 8, 16, 28, 44, 64, 90, 125, 170, 220],
    "shared_index": true,
    "display_brightness": "levels[index]",
    "led_brightness": "led_enabled ? levels[index] : 0",
    "controls": {
      "[": "index--",
      "]": "index++",
      "L": "toggle led_enabled only"
    },
    "invariants": [
      "DISPLAY_AND_LED_BRIGHTNESS_ADVANCE_ON_THE_SAME_STEP_AXIS",
      "L_DOES_NOT_CHANGE_DISPLAY_BRIGHTNESS",
      "L_DOES_NOT_CHANGE_BRIGHTNESS_INDEX",
      "LED_REENABLE_RESTORES_CURRENT_DISPLAY_STEP",
      "ANOMALY_WHITE_OBEYS_SHARED_BRIGHTNESS",
      "HOUSE_AMBER_OBEYS_SHARED_BRIGHTNESS",
      "LED_OFF_WINS_OVER_ALL_LED_COLORS"
    ],
    "implementation_source": "firmware/adv_elite/ADV_Elite_illumination_policy.h"
  },
  "do_not_transplant": [
    "flight mechanics",
    "galaxy map/game world",
    "stations/docking",
    "pirates/enemies/combat",
    "weapons",
    "asteroids/rocks as game objects",
    "ore/cargo/credits/economy",
