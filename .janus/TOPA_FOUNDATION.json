  "foundation_laws": [
    "SYNC_STATE_NOT_IDENTITY",
    "RAW_PROVENANCE_MUST_BE_PRESERVED",
    "CHANNEL_CLASSIFICATION_REQUIRED",
    "FIRSTHAND_AND_HEARSAY_MUST_BE_DISTINCT",
    "ANOMALY_IS_A_QUESTION_NOT_A_CONCLUSION",
    "NO_SOURCE_NO_POSITIVE_FACT",
    "HYPOTHESIS_IS_NOT_EVIDENCE",
    "UNCALIBRATED_CONFIDENCE_IS_NOT_EVIDENCE",
    "HEURISTIC_SCORE_IS_NOT_EVIDENCE",
    "SURVIVOR_LABEL_IS_NOT_EVIDENCE",
    "MODEL_CONSENSUS_IS_NOT_WORLD_TRUTH",
    "STATISTICAL_CLAIM_REQUIRES_MODEL_AND_UNCERTAINTY",
    "MISSING_DATA_STAYS_MISSING",
    "AUDIENCE_SIZE_IS_NOT_CORROBORATION",
    "REPETITION_IS_NOT_INDEPENDENCE",
    "INSTITUTIONAL_STATUS_IS_PROVENANCE_NOT_TRUTH",
    "SELF_IDENTIFIED_SOURCE_IS_NOT_AUTHENTICATED",
    "MODELS_MAY_NOT_REWRITE_RAW_LEDGER",
    "PREDICTIONS_MUST_BE_FROZEN_BEFORE_OUTCOME_SCORING",
    "NO_POST_HOC_REDEFINITION_TO_SAVE_A_FAILED_PREDICTION",
