    "emit_receipt_candidate": true,
    "mutate_source": false,
    "automatic_writeback": false,
    "trigger_external_effect": false,
    "destructive_actions": false
  },
  "admission": {
    "arbitrary_issue_or_pr_text_is_command": false,
    "typed_handoff_required": true,
    "explicit_human_authorization_required_for_source_writeback": true,
    "lease_is_writeback_permission": false,
    "workflow_pass_is_permission": false
  },
  "recovery_laws": [
    "DELAY != SESSION_LIVENESS_GUARANTEE",
    "SESSION_FAILURE != LOSS_OF_COORDINATION",
    "RECONNECT -> PROJECT_CHAT_SYNC -> LIVE_GITHUB_STATE",
    "SOURCE_PIN_CHANGE -> HOLD -> RECONCILE",
    "LIVE_LEASE_CONFLICT -> HOLD",
    "STALE_LEASE != DELETE_HISTORY"
  ],
  "swarm_to_git_mapping": {
    "heartbeat": "client checkpoint / lease heartbeat",
    "stale_peer_ttl": "expiring lease / stale worker state",
    "seek_idle": "WAIT/POLL without busy-loop",
    "radio_rescue": "API retry + backoff + live-state resync",
    "local_survival": "continue only already-admitted bounded local work",
    "health_line": "structured status / receipt",
    "kenshi_blackboard": "bounded shared handoff/ledger semantics"
  },
  "preservation_laws": [
    "REFACTOR != DELETE",
    "MIGRATE != ERASE_SOURCE",
    "PRESERVE EVERY ANCESTOR",
    "DESTRUCTIVE_ACTION = FORBIDDEN"
  ],
  "claim_ceiling": "This candidate defines coordination and recovery semantics. It does not guarantee ChatGPT session persistence, grant autonomous GitHub authority, authorize source writeback, or make arbitrary issue/PR text executable commands."
