    "source_history_remains_authoritative": true,
    "nexus_is_disposable_laboratory": true
  },
  "state_machine": [
    "BOOT",
    "SYNC_LIVE_GIT",
    "WAIT",
    "POLL",
    "OBSERVE_LEDGER",
    "ELIGIBILITY_CHECK",
    "ACQUIRE_BOUNDED_LEASE",
    "WORK_LOCALLY",
    "CHECKPOINT",
    "VERIFY",
    "WRITE_RECEIPT",
    "RELEASE_LEASE",
    "COOLDOWN",
    "WAIT"
  ],
  "poll_policy": {
    "idle_min_seconds": 15,
    "idle_max_seconds": 300,
    "backoff_multiplier": 1.7,
    "jitter_fraction": 0.2,
    "active_lease_heartbeat_seconds": 30,
    "tight_loop_forbidden": true,
    "values_are_defaults_not_protocol_truth": true
